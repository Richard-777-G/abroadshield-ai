// AbroadShield persistent journey data model
// PostgreSQL for production persistence; keep domain entities provider-neutral.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String             @id @default(cuid())
  email     String             @unique
  name      String?
  passwordHash String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  journey   JourneyProfile?
  events    JourneyEvent[]
  tasks     JourneyTask[]
  messages  AgentMessage[]
  connections GoogleConnection[]
}

model GoogleConnection {
  id           String   @id @default(cuid())
  userId       String
  provider     String   @default("google")
  email        String?
  accessToken  String?
  refreshToken String?
  scope        String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
  @@index([userId, provider])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JourneyProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  origin                String   @default("")
  destination           String   @default("")
  course                String   @default("")
  university            String   @default("")
  preferredUniversities String   @default("")
  careerGoal            String   @default("")
  intake                String   @default("")
  currentPhase          String   @default("pre-departure")
  readiness             Int      @default(0)
  onboarded             Boolean  @default(false)
  documentsTotal        Int      @default(0)
  documentsVerified     Int      @default(0)
  visaAppointment       String?
  funding               String?
  homeLanguage          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JourneyEvent {
  id        String   @id @default(cuid())
  userId    String
  phase     String
  type      String
  title     String
  detail    String?
  metadata  String?
  createdAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([userId, phase])
}

model JourneyTask {
  id          String    @id @default(cuid())
  userId      String
  phase       String
  type        String
  title       String
  status      String    @default("queued")
  priority    String    @default("medium")
  dueAt       DateTime?
  completedAt DateTime?
  result      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, phase, status])
  @@index([userId, dueAt])
}

model AgentMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  phase     String
  createdAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
